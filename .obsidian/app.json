{
  "alwaysUpdateLinks": true,
  "attachmentFolderPath": "./assets",
  "defaultViewMode": "preview",
  "livePreview": true,
  "newFileLocation": "current",
  "showInlineTitle": true,
  "useMarkdownLinks": true,
  "userIgnoreFilters": [
    "**/.git/**",
    "**/.idea/**",
    "**/.terraform/**",
    "**/node_modules/**",
    "**/.pnpm-store/**",
    "**/vendor/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.svelte-kit/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/target/**",
    "**/cdk.out/**",
    "**/.serverless/**",
    "**/.aws-sam/**",
    "**/.worktrees/**",
    "**/.tmp/**",
    "**/.env",
    "**/.env.local",
    "**/.env.*.local",
    "**/*.tfstate",
    "**/*.tfstate.*",
    "**/*.tfvars",
    "**/*.tfvars.json",
    "**/*.key",
    "**/*.pem",
    "**/*.p12",
    "**/*.pfx",
    "**/*.log",
    "**/*.swp",
    "**/*.swo",
    "**/.DS_Store"
  ]
}